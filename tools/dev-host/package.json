{
  "name": "@eyespy/dev-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node host for development and tests only. Phones use the native plugin.",
  "main": "./src/server.ts",
  "exports": { ".": "./src/server.ts" },
  "scripts": {
    "start": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@eyespy/engine": "workspace:*",
    "@eyespy/protocol": "workspace:*",
    "@eyespy/room": "workspace:*",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
