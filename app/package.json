{
  "name": "@eyespy/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "screenshots": "playwright test",
    "sync": "pnpm build && cap sync",
    "android": "pnpm build && cap sync android && cap open android",
    "android:build": "pnpm build && cap sync android && cd android && ./gradlew assembleDebug",
    "ios": "pnpm build && cap sync ios && cap open ios",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "7.1.0",
    "@capacitor/android": "7.4.4",
    "@capacitor/app": "7.1.0",
    "@capacitor/core": "7.4.4",
    "@capacitor/filesystem": "7.1.4",
    "@capacitor/haptics": "7.0.2",
    "@capacitor/ios": "7.4.4",
    "@capacitor/preferences": "7.0.2",
    "@capacitor/splash-screen": "7.0.3",
    "@capacitor/status-bar": "7.0.3",
    "@eyespy/engine": "workspace:*",
    "@eyespy/local-server": "workspace:*",
    "@eyespy/protocol": "workspace:*",
    "@eyespy/room": "workspace:*",
    "@fontsource-variable/fraunces": "5.2.8",
    "@fontsource-variable/outfit": "5.2.8",
    "canvas-confetti": "1.9.3",
    "capacitor-zeroconf": "4.0.0",
    "jsqr": "1.4.0",
    "motion": "12.23.24",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.4",
    "@playwright/test": "1.56.1",
    "@types/canvas-confetti": "1.9.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "sharp": "0.34.4",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
